# .versionrc - Conventional commit configuration for convco
---
header: |
  # Changelog
types:
  - type: feat
    section: Features
    hidden: false
  - type: fix
    section: Fixes
    hidden: false
  - type: perf
    section: Performance
    hidden: false
  - type: docs
    section: Documentation
    hidden: true
  - type: build
    section: Other
    hidden: true
  - type: chore
    section: Other
    hidden: true
  - type: ci
    section: Other
    hidden: true
  - type: style
    section: Other
    hidden: true
  - type: refactor
    section: Other
    hidden: true
  - type: test
    section: Other
    hidden: true
preMajor: false
commitUrlFormat: 'https://github.com/tars-cloud/website/commit/{{hash}}'
compareUrlFormat: 'https://github.com/tars-cloud/website/compare/{{previousTag}}...{{currentTag}}'
issueUrlFormat: 'https://github.com/tars-cloud/website/issues/{{issue}}'
releaseCommitMessageFormat: 'chore(release): {{currentTag}}'
issuePrefixes:
  - '#'
scopeRegex: '[[:alnum:]]+(?:[-_/][[:alnum:]]+)*'
lineLength: 80
wrapDisabled: false
linkCompare: true
linkReferences: true
